DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Stripe (test keys from https://dashboard.stripe.com/test/apikeys )
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: PostgreSQL (omit PG_HOST to use SQLite — no driver install needed)
# 1) Create DB once: createdb shopping   (or use pgAdmin)
# 2) Set PG_HOST (and password) — Django switches to ENGINE postgresql when PG_HOST is set
# 3) pip install -r requirements.txt includes psycopg2-binary for the PostgreSQL driver
# Common failures: PostgreSQL service not running, wrong password, database name does not exist,
# or peer/md5 auth in pg_hba.conf blocking your user from 127.0.0.1
# PG_HOST=localhost
# PG_DATABASE=shopping
# PG_USER=postgres
# PG_PASSWORD=secret
# PG_PORT=5432

# CORS: comma-separated origins for Vue/React/Angular dev servers (defaults include :5173 :5174 :4200)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4200
