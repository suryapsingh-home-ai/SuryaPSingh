@page "/admin/projects"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject ISiteContentService SiteContent

<PageTitle>Projects — Admin</PageTitle>

<div class="admin-toolbar">
    <h2>Projects</h2>
    <button type="button" class="btn btn-primary" @onclick="ShowCreate">Add Project</button>
</div>

@if (showForm)
{
    <div class="admin-panel">
        <EditForm Model="editing" OnValidSubmit="Save">
            <div class="form-group">
                <label>Title</label>
                <InputText @bind-Value="editing.Title" class="form-control" />
            </div>
            <div class="form-group">
                <label>Description</label>
                <InputTextArea @bind-Value="editing.Description" class="form-control" rows="3" />
            </div>
            <div class="form-group">
                <label>Tech Stack</label>
                <InputText @bind-Value="editing.TechStack" class="form-control" />
            </div>
            <div class="form-group">
                <label>Repository URL</label>
                <InputText @bind-Value="editing.RepositoryUrl" class="form-control" />
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Sort Order</label>
                    <InputNumber @bind-Value="editing.SortOrder" class="form-control" />
                </div>
                <div class="form-group form-check-inline">
                    <InputCheckbox @bind-Value="editing.IsVisible" id="proj-visible" />
                    <label for="proj-visible">Visible</label>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Save</button>
                <button type="button" class="btn btn-outline" @onclick="() => showForm = false">Cancel</button>
            </div>
        </EditForm>
    </div>
}

<table class="admin-table">
    <thead>
        <tr><th>Title</th><th>Tech</th><th>Visible</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var project in projects)
        {
            <tr>
                <td>@project.Title</td>
                <td>@project.TechStack</td>
                <td>@(project.IsVisible ? "Yes" : "No")</td>
                <td class="table-actions">
                    <button type="button" class="btn btn-sm btn-outline" @onclick="() => Edit(project)">Edit</button>
                    <button type="button" class="btn btn-sm btn-danger" @onclick="() => Delete(project.Id)">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private IReadOnlyList<Project> projects = [];
    private Project editing = new();
    private bool showForm;

    protected override async Task OnInitializedAsync() =>
        await Reload();

    private async Task Reload() =>
        projects = await SiteContent.GetProjectsAsync(visibleOnly: false);

    private void ShowCreate()
    {
        editing = new Project { SortOrder = projects.Count + 1, IsVisible = true };
        showForm = true;
    }

    private void Edit(Project project)
    {
        editing = new Project
        {
            Id = project.Id,
            Title = project.Title,
            Description = project.Description,
            TechStack = project.TechStack,
            RepositoryUrl = project.RepositoryUrl,
            SortOrder = project.SortOrder,
            IsVisible = project.IsVisible
        };
        showForm = true;
    }

    private async Task Save()
    {
        await SiteContent.SaveProjectAsync(editing);
        showForm = false;
        await Reload();
    }

    private async Task Delete(int id)
    {
        await SiteContent.DeleteProjectAsync(id);
        await Reload();
    }
}
