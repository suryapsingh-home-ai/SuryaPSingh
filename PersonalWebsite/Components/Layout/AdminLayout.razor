@inherits LayoutComponentBase

<div class="admin-shell">
    <aside class="admin-sidebar">
        <div class="admin-brand">Site Admin</div>
        <nav class="admin-nav">
            <NavLink href="/admin" Match="NavLinkMatch.All">Dashboard</NavLink>
            <NavLink href="/admin/profile">Profile</NavLink>
            <NavLink href="/admin/sections">Sections</NavLink>
            <NavLink href="/admin/skills">Skills</NavLink>
            <NavLink href="/admin/projects">Projects</NavLink>
            <NavLink href="/admin/blog">Blog Posts</NavLink>
