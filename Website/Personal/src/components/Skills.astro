---
interface SkillGroup {
  label: string;
  items: string;
}

interface Props {
  groups: SkillGroup[];
}

const { groups } = Astro.props;
---

<section class="section" id="skills" aria-labelledby="skills-heading">
  <div class="wrap">
    <div class="reveal">
      <p class="eyebrow">Toolkit</p>
      <h2 class="section-title" id="skills-heading">Skills</h2>
    </div>
    <dl class="skills">
      {
        groups.map((group, index) => (
          <div class="row reveal" style={`transition-delay: ${index * 50}ms`}>
            <dt>{group.label}</dt>
            <dd>{group.items}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .skills {
    margin: 2rem 0 0;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(8rem, 12rem) 1fr;
    gap: 0.75rem 1.5rem;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
  }

  .row:last-child {
    border-bottom: 1px solid var(--line);
  }

  dt {
    margin: 0;
    font-weight: 700;
    color: var(--ink);
  }

  dd {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }
</style>
