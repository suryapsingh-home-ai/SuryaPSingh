---
interface Cert {
  code: string;
  name: string;
}

interface Edu {
  degree: string;
  school: string;
  dates: string;
}

interface Props {
  certifications: Cert[];
  education: Edu[];
}

const { certifications, education } = Astro.props;
---

<section class="section" id="credentials" aria-labelledby="credentials-heading">
  <div class="wrap">
    <div class="reveal">
      <p class="eyebrow">Credentials</p>
      <h2 class="section-title" id="credentials-heading">Certifications & education</h2>
    </div>
    <div class="grid">
      <div class="reveal">
        <h3>Certifications</h3>
        <ul>
          {
            certifications.map((cert) => (
              <li>
                <span class="code">{cert.code}</span>
                {cert.name}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="reveal" style="transition-delay: 80ms">
        <h3>Education</h3>
        <ul>
          {
            education.map((item) => (
              <li>
                <strong>{item.degree}</strong>
                <span class="meta">{item.school}</span>
                <span class="meta">{item.dates}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .grid {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  h3 {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    padding: 0.85rem 0;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
  }

  li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .code {
    display: inline-block;
    margin-right: 0.55rem;
    font-weight: 700;
    color: var(--accent);
  }

  .meta {
    display: block;
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  @media (max-width: 800px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
