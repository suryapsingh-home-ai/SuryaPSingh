---
interface Props {
  name: string;
  note: string;
}

const { name, note } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap bar">
    <p>© {year} {name}</p>
    <p class="note">{note}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding: 1.5rem 0 2rem;
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .note {
    max-width: 28rem;
  }
</style>
