---
interface Highlight {
  title: string;
  summary: string;
}

interface Props {
  items: Highlight[];
}

const { items } = Astro.props;
---

<section class="section" id="highlights" aria-labelledby="highlights-heading">
  <div class="wrap">
    <div class="reveal">
      <p class="eyebrow">Selected work</p>
      <h2 class="section-title" id="highlights-heading">Highlights</h2>
      <p class="lede">AI tooling and platform work that shows how I ship beyond feature tickets.</p>
    </div>
    <ul class="list">
      {
        items.map((item, index) => (
          <li class="item reveal" style={`transition-delay: ${index * 70}ms`}>
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .list {
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .item {
    display: grid;
    grid-template-columns: minmax(10rem, 16rem) 1fr;
    gap: 1rem 2rem;
    padding: 1.35rem 0;
    border-top: 1px solid var(--line);
  }

  .item:last-child {
    border-bottom: 1px solid var(--line);
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }

  p {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 720px) {
    .item {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }
  }
</style>
